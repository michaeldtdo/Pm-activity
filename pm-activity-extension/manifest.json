{
  "manifest_version": 3,
  "name": "PM Activity Tracker",
  "version": "2.1.0",
  "description": "Track PM work activity with AI-powered auto-card generation, live staging, and context synthesis",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "nativeMessaging",
    "sidePanel"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/*"],
      "js": ["content/google-docs.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.slack.com/*"],
      "js": ["content/slack.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.atlassian.net/*"],
      "js": ["content/jira.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://teams.microsoft.com/*"],
      "js": ["content/teams.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content/claude.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/activity-observer.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Open PM Activity Panel"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
